{
  "name": "codrive",
  "version": "0.9.5",
  "description": "A local Codex co-driving service for autonomous product development.",
  "keywords": [
    "codex",
    "codex-app",
    "ai-agent",
    "coding-agent",
    "workflow",
    "task-board",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzj960515/codrive.git"
  },
  "homepage": "https://github.com/lzj960515/codrive#readme",
  "bugs": {
    "url": "https://github.com/lzj960515/codrive/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "bin": {
    "codrive": "dist/interfaces/cli/index.js"
  },
  "files": [
    "dist",
    "skills",
    "hooks",
    "docs/architecture/product-facts.md",
    "docs/architecture/realtime-sync.md",
    "README.md",
    "README.zh-CN.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "dev": "tsx src/interfaces/cli/index.ts serve",
    "start": "node dist/interfaces/cli/index.js serve",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@openai/codex": "0.146.0",
    "fastify": "5.11.0",
    "proper-lockfile": "4.1.2",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/proper-lockfile": "4.1.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "license": "MIT"
}
