        <mxCell id="title" value="Codrive 如何把产品工作持续推进到当前无待办" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=32;fontStyle=1;fontColor=#243142;" vertex="1" parent="1">
          <mxGeometry x="70" y="35" width="1500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="上半部分是产品轮转，下半部分说明任务消息如何避免重叠，以及即时触发与 60 秒检查分别负责什么。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=17;fontColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="72" y="82" width="1500" height="34" as="geometry" />
        </mxCell>

