        <mxCell id="title" value="Codrive 如何把一个产品想法持续推进到完成" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=32;fontStyle=1;fontColor=#243142;" vertex="1" parent="1">
          <mxGeometry x="70" y="35" width="1500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="上半部分是业务轮转，下半部分说明谁会触发调度，以及 60 秒检查真正负责什么。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=17;fontColor=#64748B;" vertex="1" parent="1">
