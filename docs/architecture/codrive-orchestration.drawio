<mxfile host="Agent">
  <diagram id="codrive-orchestration" name="Codrive Orchestration">
    <mxGraphModel grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1580" background="#FFFDF5">
      <root>
