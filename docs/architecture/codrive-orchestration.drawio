        <mxCell id="e-all-selection" value="否：任务完成 → revision + 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;sketch=1;curveFitting=1;jiggle=2;strokeColor=#243142;strokeWidth=2.5;endArrow=classic;endFill=1;endSize=18;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=14;fontColor=#243142;labelBackgroundColor=#FFFDF5;" edge="1" parent="1" source="all-done" target="selection"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1095" y="790" /><mxPoint x="2020" y="790" /><mxPoint x="2020" y="455" /></Array><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell>
        <mxCell id="e-idle-new-work" value="用户明确追加" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;sketch=1;curveFitting=1;jiggle=2;strokeColor=#D97736;strokeWidth=2.5;endArrow=classic;endFill=1;endSize=18;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=14;fontColor=#7C3514;labelBackgroundColor=#FFFDF5;" edge="1" parent="1" source="idle" target="new-work"><mxGeometry x="0" y="-1" relative="1" as="geometry"><mxPoint x="0" y="-16" as="offset" /></mxGeometry></mxCell>
        <mxCell id="e-new-work-selection" value="进入 active · revision + 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;sketch=1;curveFitting=1;jiggle=2;strokeColor=#D97736;strokeWidth=2.5;endArrow=classic;endFill=1;endSize=18;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=14;fontColor=#7C3514;labelBackgroundColor=#FFFDF5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="new-work" target="selection"><mxGeometry x="0" y="-1" relative="1" as="geometry"><mxPoint x="58" y="0" as="offset" /></mxGeometry></mxCell>

        <mxCell id="polling-note" value="正常推进由事实变化立即触发；空闲容量只是执行条件，不是规划事件。同一 planning revision 最多自动选择一次，少选也代表本轮完成。每 60 秒检查只恢复真实中断并调用正常 reconcile；backlog 仅在当前 revision 尚未评估时启动选择。" style="shape=note;whiteSpace=wrap;html=1;size=18;sketch=1;curveFitting=1;jiggle=2;fillColor=#FFF4D6;strokeColor=#D97736;strokeWidth=2;hachureGap=10;fillWeight=1;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=17;fontStyle=1;fontColor=#7C3514;align=left;spacingLeft=18;" vertex="1" parent="1">
          <mxGeometry x="250" y="935" width="1600" height="105" as="geometry" />
        </mxCell>

        <mxCell id="trigger-group" value="调度触发与本地运行架构" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;sketch=1;curveFitting=1;jiggle=2;fillColor=none;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;dashPattern=8 6;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=18;fontStyle=1;fontColor=#243142;verticalAlign=top;align=left;spacingTop=14;spacingLeft=18;" vertex="1" parent="1">
          <mxGeometry x="60" y="1060" width="1980" height="480" as="geometry" />
        </mxCell>
        <mxCell id="immediate-events" value="规划版本事件&lt;br&gt;&lt;br&gt;• 项目注册 / 显式新增工作&lt;br&gt;• 完整 task done / cancel&lt;br&gt;• 产品决定 / 人工 replan&lt;br&gt;• 并发配置变化&lt;br&gt;&lt;br&gt;阶段报告只推进 continuation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;sketch=1;curveFitting=1;jiggle=2;fillColor=#DCEBFF;strokeColor=#243142;strokeWidth=2;hachureGap=8;fillWeight=1.5;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=15;fontColor=#243142;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="90" y="1120" width="350" height="220" as="geometry" />
        </mxCell>
        <mxCell id="recovery" value="自动恢复&lt;br&gt;&lt;br&gt;• 服务启动：恢复真实中断的任务与 attempt&lt;br&gt;• 对话变空闲：重试待发送消息&lt;br&gt;• 每 60 秒：检查无结果的 AI 工作并正常 reconcile&lt;br&gt;• 已评估 revision 记录 suppressed，不重复选择" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;sketch=1;curveFitting=1;jiggle=2;fillColor=#F9DFDF;strokeColor=#B94A48;strokeWidth=2;hachureGap=8;fillWeight=1.5;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=15;fontColor=#7F1D1D;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="470" y="1125" width="360" height="210" as="geometry" />
        </mxCell>
        <mxCell id="reconcile" value="WorkflowEngine.reconcile&lt;br&gt;&lt;br&gt;&lt;b&gt;1. continuation：审查 / 返工 / 合入优先&lt;br&gt;2. 未评估 revision 的 backlog selection&lt;br&gt;3. 全部任务终态后进入 idle&lt;br&gt;&lt;br&gt;项目级并发 + repository integration lease&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;sketch=1;curveFitting=1;jiggle=2;fillColor=#FFF2CC;strokeColor=#243142;strokeWidth=2.5;hachureGap=8;fillWeight=1.5;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=15;fontColor=#243142;" vertex="1" parent="1">
          <mxGeometry x="875" y="1135" width="290" height="180" as="geometry" />
        </mxCell>
        <mxCell id="conversation-active" value="当前任务对话&lt;br&gt;正在执行？" style="rhombus;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fillColor=#FFF2CC;strokeColor=#243142;strokeWidth=2.5;hachureGap=8;fillWeight=1.5;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=16;fontStyle=1;fontColor=#243142;" vertex="1" parent="1">
          <mxGeometry x="1210" y="1135" width="230" height="180" as="geometry" />
        </mxCell>
        <mxCell id="deferred-turn" value="保留待发送状态&lt;br&gt;&lt;b&gt;pending / awaiting_report&lt;/b&gt;&lt;br&gt;等待对话空闲或自动恢复检查" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;sketch=1;curveFitting=1;jiggle=2;fillColor=#F9DFDF;strokeColor=#B94A48;strokeWidth=2;hachureGap=8;fillWeight=1.5;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=15;fontColor=#7F1D1D;" vertex="1" parent="1">
          <mxGeometry x="1190" y="1380" width="270" height="105" as="geometry" />
        </mxCell>
        <mxCell id="app-server" value="Codex App Server&lt;br&gt;&lt;br&gt;thread/start 或 resume&lt;br&gt;turn/start&lt;br&gt;完成事件回传" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;sketch=1;curveFitting=1;jiggle=2;fillColor=#E9E1F7;strokeColor=#243142;strokeWidth=2;hachureGap=8;fillWeight=1.5;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=16;fontColor=#243142;" vertex="1" parent="1">
          <mxGeometry x="1495" y="1125" width="245" height="190" as="geometry" />
        </mxCell>
        <mxCell id="state-store" value="~/.codrive&lt;br&gt;&lt;b&gt;project / task JSON&lt;br&gt;planning revision + evaluatedRevision&lt;br&gt;current execution&lt;br&gt;TaskActivity in events.ndjson&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;sketch=1;curveFitting=1;jiggle=2;fillColor=#DFF3E4;strokeColor=#243142;strokeWidth=2;hachureGap=8;fillWeight=1.5;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=14;fontColor=#243142;" vertex="1" parent="1">
          <mxGeometry x="1780" y="1115" width="240" height="135" as="geometry" />
        </mxCell>
        <mxCell id="process-log" value="~/.codrive/codrive.log&lt;br&gt;&lt;br&gt;Codex stderr / HTTP 错误 / 生命周期&lt;br&gt;&lt;b&gt;按本机时区显示&lt;/b&gt;" style="shape=note;whiteSpace=wrap;html=1;size=18;sketch=1;curveFitting=1;jiggle=2;fillColor=#DFF3E4;strokeColor=#243142;strokeWidth=2;hachureGap=10;fillWeight=1;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=14;fontColor=#243142;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="1785" y="1335" width="230" height="120" as="geometry" />
        </mxCell>

        <mxCell id="e-immediate-reconcile" value="事件立即触发" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;sketch=1;curveFitting=1;jiggle=2;strokeColor=#243142;strokeWidth=2.5;endArrow=classic;endFill=1;endSize=18;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=14;fontColor=#243142;labelBackgroundColor=#FFFDF5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="immediate-events" target="reconcile"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="265" y="1090" /><mxPoint x="1020" y="1090" /></Array><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell>
        <mxCell id="e-recovery-reconcile" value="异常恢复后重新协调" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;sketch=1;curveFitting=1;jiggle=2;strokeColor=#B94A48;strokeWidth=2.5;endArrow=classic;endFill=1;endSize=18;dashed=1;dashPattern=8 6;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=14;fontColor=#7F1D1D;labelBackgroundColor=#FFFDF5;" edge="1" parent="1" source="recovery" target="reconcile"><mxGeometry x="0" y="-1" relative="1" as="geometry"><mxPoint x="0" y="-16" as="offset" /></mxGeometry></mxCell>
        <mxCell id="e-reconcile-conversation" value="准备发送任务消息" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;sketch=1;curveFitting=1;jiggle=2;strokeColor=#243142;strokeWidth=2.5;endArrow=classic;endFill=1;endSize=18;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=14;fontColor=#243142;labelBackgroundColor=#FFFDF5;" edge="1" parent="1" source="reconcile" target="conversation-active"><mxGeometry x="0" y="-1" relative="1" as="geometry"><mxPoint x="0" y="-16" as="offset" /></mxGeometry></mxCell>
        <mxCell id="e-conversation-appserver" value="否：turn/start" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;sketch=1;curveFitting=1;jiggle=2;strokeColor=#243142;strokeWidth=2.5;endArrow=classic;endFill=1;endSize=18;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=14;fontColor=#243142;labelBackgroundColor=#FFFDF5;" edge="1" parent="1" source="conversation-active" target="app-server"><mxGeometry x="0" y="-1" relative="1" as="geometry"><mxPoint x="0" y="-16" as="offset" /></mxGeometry></mxCell>
        <mxCell id="e-conversation-deferred" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;sketch=1;curveFitting=1;jiggle=2;strokeColor=#B94A48;strokeWidth=2.5;endArrow=classic;endFill=1;endSize=18;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=14;fontColor=#7F1D1D;labelBackgroundColor=#FFFDF5;" edge="1" parent="1" source="conversation-active" target="deferred-turn"><mxGeometry x="0" y="-1" relative="1" as="geometry"><mxPoint x="44" y="0" as="offset" /></mxGeometry></mxCell>
        <mxCell id="e-appserver-events" value="回合完成或失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;sketch=1;curveFitting=1;jiggle=2;strokeColor=#243142;strokeWidth=2.5;endArrow=classic;endFill=1;endSize=18;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=14;fontColor=#243142;labelBackgroundColor=#FFFDF5;" edge="1" parent="1" source="app-server" target="immediate-events"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1618" y="1520" /><mxPoint x="265" y="1520" /></Array><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell>
        <mxCell id="e-appserver-recovery" value="thread/status/changed: idle" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;sketch=1;curveFitting=1;jiggle=2;strokeColor=#B94A48;strokeWidth=2.5;endArrow=classic;endFill=1;endSize=18;dashed=1;dashPattern=8 6;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=14;fontColor=#7F1D1D;labelBackgroundColor=#FFFDF5;" edge="1" parent="1" source="app-server" target="recovery"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1618" y="1495" /><mxPoint x="650" y="1495" /></Array><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell>
        <mxCell id="e-reconcile-state" value="原子快照 + 事件追加" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;sketch=1;curveFitting=1;jiggle=2;strokeColor=#243142;strokeWidth=2.5;startArrow=classic;startFill=1;endArrow=classic;endFill=1;endSize=18;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=14;fontColor=#243142;labelBackgroundColor=#FFFDF5;" edge="1" parent="1" source="reconcile" target="state-store"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1020" y="1085" /><mxPoint x="1902" y="1085" /></Array><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell>
        <mxCell id="e-appserver-log" value="stderr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;sketch=1;curveFitting=1;jiggle=2;strokeColor=#D97736;strokeWidth=2.5;endArrow=classic;endFill=1;endSize=18;dashed=1;dashPattern=8 6;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=14;fontColor=#7C3514;labelBackgroundColor=#FFFDF5;" edge="1" parent="1" source="app-server" target="process-log"><mxGeometry x="0" y="-1" relative="1" as="geometry"><mxPoint x="44" y="0" as="offset" /></mxGeometry></mxCell>
